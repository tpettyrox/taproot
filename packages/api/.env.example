PORT=3001

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=taprootpass

# MinIO object storage (S3-compatible)
# For real AWS S3 or Cloudflare R2, omit STORAGE_ENDPOINT and set your region/credentials
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=taproot
STORAGE_SECRET_KEY=taprootpass
STORAGE_BUCKET=taproot-media
STORAGE_REGION=us-east-1

# CompreFace face recognition
# COMPREFACE_API_KEY is generated in the CompreFace UI (localhost:8000) after first run
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=
FACE_SIMILARITY_THRESHOLD=0.85

# Claude document extraction
ANTHROPIC_API_KEY=sk-ant-...

# Upload limits
MAX_FILE_SIZE_MB=50
